# Connection string for the Postgres that holds sessions, rounds, characters and finds.
# The test suite never uses this database; it derives wheres_waldo_test from it.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/wheres_waldo

# Signs the opaque session cookie. Any long random string; rotating it logs
# every session out. Must be set in production.
SESSION_SECRET=

# Must be "production" on the deployed service: it is what makes the session
# cookie `secure`. Nothing sets it for you — a deploy that forgets it ships a
# cookie the browser will send over plain HTTP.
NODE_ENV=development

# Port the server listens on.
PORT=3000
